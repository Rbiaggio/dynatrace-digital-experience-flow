# API gateway da DMZ (banco-gateway): ponto de entrada de TODAS as chamadas de API, como num banco típico.
# Recebe as chamadas dos sites (repassadas pelos servidores web banco-web-pf/pj, que só entregam as páginas) e do app
# mobile (pelo túnel público) e entrega ao ingress da rede interna. Não conhece os serviços de trás.
server {
    listen 80;
    server_name ${NOME_SERVIDOR};   # nome do serviço do nginx no Dynatrace (banco-gateway)

    location = /saude { access_log off; return 200 "ok\n"; }

    # APIs dos canais: web (/api/) e mobile (/v1/) seguem para o ingress da rede interna
    location ~ ^/(api|v1)/ {
        # resolve "ingress" a cada requisição pelo DNS do Docker (recriar o container muda o IP)
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $ingress_upstream http://ingress:80;
        proxy_pass $ingress_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host banco-ingress;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / { return 404; }
}
