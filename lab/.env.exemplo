# Copie para .env (nesta pasta lab/) e preencha.

# RUM_TAG = snippet completo da aplicação web (modo agentless) criada no seu tenant.
RUM_TAG=<script type="text/javascript" src="https://js-cdn.dynatrace.com/jstag/.../..._complete.js" crossorigin="anonymous"></script>

# Segundo canal (Banco Demo Empresas, porta 8089): outra aplicação web no tenant, criada no seu tenant (aplicação web do RUM)
RUM_TAG_EMPRESAS=<script type="text/javascript" src="https://js-cdn.dynatrace.com/jstag/.../..._complete.js" crossorigin="anonymous"></script>
PARALELO_EMPRESAS=1

# OneAgent application-only nas imagens da API (Node) e do core (Python).
# Token de acesso do tenant com o escopo "PaaS integration - Installer download" (InstallerDownload).
# Deixe vazio para construir as imagens sem instrumentação.
DT_TENANT_URL=https://SEU-AMBIENTE.live.dynatrace.com
DT_PAAS_TOKEN=

# gerador de jornadas
PARALELO=2
PAUSA_MS=2000
TOTAL=0
